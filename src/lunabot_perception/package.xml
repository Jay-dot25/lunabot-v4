<?xml version="1.0"?>
<package format="3">
  <name>lunabot_perception</name>
  <version>0.1.0</version>
  <description>LunaBot terrain perception nodes and interfaces.</description>
  <maintainer email="maintainers@lunabot.invalid">LunaBot Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
