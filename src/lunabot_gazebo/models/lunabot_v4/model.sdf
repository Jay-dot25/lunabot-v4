<?xml version="1.0"?>
<sdf version="1.9">
  <model name="lunabot_v4">
    <pose>0 0 0.52 0 0 0</pose>

    <!-- ================= MAIN CHASSIS (COMPACT TRUE-SCALE LUNAR ROVER: 0.54m x 0.38m GOLD MLI FOIL BODY) ================= -->
    <link name="chassis">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 -0.26 0 0 0</pose><mass>18.0</mass>
        <inertia><ixx>0.48</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.72</iyy><iyz>0</iyz><izz>0.96</izz></inertia>
      </inertial>
      <collision name="body_collision"><pose>0 0 -0.12 0 0 0</pose><geometry><box><size>0.54 0.38 0.15</size></box></geometry></collision>
      <visual name="body_visual">
        <pose>0 0 -0.12 0 0 0</pose>
        <geometry><box><size>0.54 0.38 0.15</size></box></geometry>
        <material><ambient>0.68 0.48 0.10 1</ambient><diffuse>0.88 0.65 0.16 1</diffuse><specular>0.75 0.65 0.28 1</specular></material>
      </visual>
      <visual name="radiator_louver_visual">
        <pose>-0.04 0 -0.04 0 0 0</pose>
        <geometry><box><size>0.38 0.28 0.02</size></box></geometry>
        <material><ambient>0.12 0.13 0.15 1</ambient><diffuse>0.18 0.20 0.23 1</diffuse><specular>0.4 0.4 0.45 1</specular></material>
      </visual>
    </link>

    <!-- ================= LOWER ARMOR ================= -->
    <link name="lower_armor">
      <pose relative_to="chassis">-0.02 0 -0.21 0 0 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.06</iyy><iyz>0</iyz><izz>0.08</izz></inertia></inertial>
      <collision name="armor_collision"><geometry><box><size>0.48 0.34 0.04</size></box></geometry></collision>
      <visual name="armor_visual">
        <geometry><box><size>0.48 0.34 0.04</size></box></geometry>
        <material><ambient>0.15 0.16 0.18 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material>
      </visual>
    </link>
    <joint name="lower_armor_joint" type="fixed"><parent>chassis</parent><child>lower_armor</child></joint>

    <!-- ================= UPPER ELECTRONICS DECK ================= -->
    <link name="upper_deck">
      <pose relative_to="chassis">-0.02 0 -0.03 0 0 0</pose>
      <inertial><mass>1.8</mass><inertia><ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.05</iyy><iyz>0</iyz><izz>0.07</izz></inertia></inertial>
