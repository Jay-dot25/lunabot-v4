        <material><ambient>0.75 0.76 0.78 1</ambient><diffuse>0.88 0.89 0.91 1</diffuse></material>
      </visual>
    </link>
    <joint name="upper_deck_joint" type="fixed"><parent>chassis</parent><child>upper_deck</child></joint>

    <!-- ================= FRONT ARMOR / APXS SPECTROMETER BUMPER ================= -->
    <link name="front_armor">
      <pose relative_to="chassis">0.29 0 -0.13 0 0.28 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.02</izz></inertia></inertial>
