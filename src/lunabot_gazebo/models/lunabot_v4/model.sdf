    </link>
    <joint name="front_armor_joint" type="fixed"><parent>chassis</parent><child>front_armor</child></joint>

    <!-- ================= SIDE RAILS ================= -->
    <link name="left_side_rail">
      <pose relative_to="chassis">-0.01 0.21 -0.12 0 0 0</pose>
      <inertial><mass>0.3</mass><inertia><ixx>0.0004</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
