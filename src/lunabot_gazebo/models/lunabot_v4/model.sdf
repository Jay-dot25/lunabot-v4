      <inertial><mass>1.4</mass><inertia><ixx>0.012</ixx><iyy>0.012</iyy><izz>0.020</izz></inertia></inertial>
      <collision name="wheel_collision"><geometry><cylinder><radius>0.115</radius><length>0.085</length></cylinder></geometry><surface><friction><ode><mu>4.0</mu><mu2>4.0</mu2></ode></friction></surface></collision>
      <visual name="wheel_visual"><geometry><cylinder><radius>0.115</radius><length>0.085</length></cylinder></geometry><material><ambient>0.18 0.19 0.21 1</ambient><diffuse>0.28 0.29 0.32 1</diffuse><specular>0.35 0.35 0.40 1</specular></material></visual>
      <visual name="hub_visual"><geometry><cylinder><radius>0.055</radius><length>0.092</length></cylinder></geometry><material><ambient>0.65 0.48 0.12 1</ambient><diffuse>0.85 0.64 0.16 1</diffuse></material></visual>
    </link>

    <!-- ================= COMPACT SOLAR PANELS ================= -->
    <link name="left_solar_panel">
      <pose relative_to="chassis">-0.04 0.28 -0.02 0.18 0 0</pose>
      <inertial><mass>0.4</mass><inertia><ixx>0.003</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <visual name="panel"><geometry><box><size>0.42 0.16 0.015</size></box></geometry><material><ambient>0.06 0.14 0.38 1</ambient><diffuse>0.10 0.24 0.65 1</diffuse><specular>0.6 0.65 0.75 1</specular></material></visual>
    </link>
    <joint name="left_solar_panel_joint" type="fixed"><parent>chassis</parent><child>left_solar_panel</child></joint>

    <link name="right_solar_panel">
      <pose relative_to="chassis">-0.04 -0.28 -0.02 -0.18 0 0</pose>
      <inertial><mass>0.4</mass><inertia><ixx>0.003</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <visual name="panel"><geometry><box><size>0.42 0.16 0.015</size></box></geometry><material><ambient>0.06 0.14 0.38 1</ambient><diffuse>0.10 0.24 0.65 1</diffuse><specular>0.6 0.65 0.75 1</specular></material></visual>
    </link>
    <joint name="right_solar_panel_joint" type="fixed"><parent>chassis</parent><child>right_solar_panel</child></joint>

    <!-- ================= SENSOR MAST ================= -->
    <link name="sensor_mast">
      <pose relative_to="chassis">0.18 0 0.54 0 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="mast"><pose>0 0 -0.28 0 0 0</pose><geometry><cylinder><radius>0.022</radius><length>0.42</length></cylinder></geometry><material><ambient>0.65 0.50 0.16 1</ambient><diffuse>0.82 0.64 0.20 1</diffuse><specular>0.8 0.7 0.4 1</specular></material></visual>
    </link>
    <joint name="sensor_mast_joint" type="fixed"><parent>chassis</parent><child>sensor_mast</child></joint>

    <!-- ========== FIXED SENSOR HEAD (HOLDS 360° LIDAR BASE SO SLAM TF IS INVARIANT) ========== -->
    <joint name="sensor_head_joint" type="fixed">
      <pose relative_to="sensor_mast">0 0 0.31 0 0 0</pose>
      <parent>sensor_mast</parent><child>sensor_head</child>
    </joint>
    <link name="sensor_head">
      <pose relative_to="sensor_head_joint">0 0 0 0 0 0</pose>
      <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="lidar_collar_visual">
        <pose>0 0 -0.38 0 0 0</pose>
        <geometry><cylinder><radius>0.032</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.18 0.20 0.24 1</ambient><diffuse>0.28 0.30 0.35 1</diffuse></material>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <pose relative_to="sensor_head">0.02 0 0.09 0 0.5 0</pose>
        <update_rate>10</update_rate>
        <topic>/lunabot/lidar/scan</topic>
        <ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>60</max><resolution>0.01</resolution></range></ray>
        <always_on>true</always_on><visualize>true</visualize>
      </sensor>
    </link>

    <!-- ========== 360-DEGREE ROTATABLE CAMERA PAN JOINT (-360° TO +360° CONTINUOUS) ========== -->
    <joint name="mast_pan_joint" type="revolute">
      <pose relative_to="sensor_head">0 0 -0.34 0 0 0</pose>
      <parent>sensor_head</parent><child>mast_pan_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-6.28318</lower><upper>6.28318</upper><effort>20</effort><velocity>3.5</velocity></limit>
        <dynamics><damping>0.8</damping><friction>0.05</friction></dynamics>
      </axis>
    </joint>
    <link name="mast_pan_link">
      <pose relative_to="mast_pan_joint">0 0 0 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.0001217</ixx><iyy>0.0001217</iyy><izz>0.00016</izz></inertia></inertial>
      <visual name="pan_visual">
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.50 0.52 0.56 1</ambient><diffuse>0.72 0.74 0.78 1</diffuse></material>
      </visual>
    </link>

    <!-- ========== AUTOMATIC SITUATIONAL CAMERA TILT JOINT + 360° CAMERA TURRET ========== -->
    <joint name="mast_tilt_joint" type="revolute">
      <pose relative_to="mast_pan_link">0 0 0 0 0 0</pose>
      <parent>mast_pan_link</parent><child>mast_tilt_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-0.65</lower><upper>0.65</upper><effort>15</effort><velocity>2.5</velocity></limit>
        <dynamics><damping>0.8</damping><friction>0.05</friction></dynamics>
      </axis>
    </joint>
    <link name="mast_tilt_link">
      <pose relative_to="mast_tilt_joint">0 0 0 0 0 0</pose>
      <inertial><mass>0.4</mass><inertia><ixx>0.002</ixx><iyy>0.003</iyy><izz>0.003</izz></inertia></inertial>
      <visual name="head">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.14 0.16 0.085</size></box></geometry>
        <material><ambient>0.76 0.77 0.80 1</ambient><diffuse>0.90 0.91 0.94 1</diffuse></material>
      </visual>
      <visual name="lens_left">
        <pose>0.072 0.045 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.05 0.08 0.12 1</ambient><diffuse>0.08 0.12 0.18 1</diffuse><specular>0.9 0.9 0.95 1</specular></material>
      </visual>
      <visual name="lens_right">
        <pose>0.072 -0.045 0 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.05 0.08 0.12 1</ambient><diffuse>0.08 0.12 0.18 1</diffuse><specular>0.9 0.9 0.95 1</specular></material>
      </visual>
      <visual name="cam_360_turret_ring">
        <pose>0 0 0.052 0 0 0</pose>
        <geometry><cylinder><radius>0.042</radius><length>0.022</length></cylinder></geometry>
        <material><ambient>0.68 0.48 0.10 1</ambient><diffuse>0.88 0.65 0.16 1</diffuse><specular>0.75 0.65 0.28 1</specular></material>
      </visual>
      <visual name="cam_360_dome_lens">
        <pose>0 0 0.068 0 0 0</pose>
        <geometry><sphere><radius>0.036</radius></sphere></geometry>
        <material><ambient>0.08 0.22 0.38 1</ambient><diffuse>0.14 0.36 0.58 1</diffuse><specular>0.95 0.95 1.0 1</specular></material>
      </visual>
      <visual name="cam_direction_beacon">
        <pose>0.055 0 0.052 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.010</radius><length>0.020</length></cylinder></geometry>
        <material><ambient>0.10 0.85 0.95 1</ambient><diffuse>0.15 0.95 1.0 1</diffuse><emissive>0.12 0.85 0.98 1</emissive></material>
      </visual>

      <sensor name="rgb_camera" type="camera">
        <pose relative_to="mast_tilt_link">0.14 0 0.34 0 0 0</pose>
        <update_rate>20</update_rate>
        <camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>120</far></clip></camera>
        <always_on>true</always_on><visualize>true</visualize><topic>/lunabot/camera/image_raw</topic>
      </sensor>

      <sensor name="depth_camera" type="depth_camera">
        <pose relative_to="mast_tilt_link">0.14 0 0.30 0 0 0</pose>
        <update_rate>15</update_rate>
        <camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height></image><clip><near>0.10</near><far>40</far></clip></camera>
        <always_on>true</always_on><visualize>true</visualize><topic>/lunabot/depth/image_raw</topic>
      </sensor>
    </link>

    <!-- ================= ANTENNA ================= -->
    <link name="antenna">
      <pose relative_to="chassis">-0.20 0 0.14 0 0 0</pose>
      <inertial><mass>0.2</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.00004</izz></inertia></inertial>
      <visual name="antenna_stem"><geometry><cylinder><radius>0.010</radius><length>0.24</length></cylinder></geometry><material><ambient>0.55 0.56 0.58 1</ambient><diffuse>0.75 0.76 0.78 1</diffuse></material></visual>
      <visual name="hga_dish"><pose>0 0 0.13 0 0.55 0</pose><geometry><cylinder><radius>0.065</radius><length>0.015</length></cylinder></geometry><material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.94 0.96 0.98 1</diffuse></material></visual>
    </link>
    <joint name="antenna_joint" type="fixed"><parent>chassis</parent><child>antenna</child></joint>

    <!-- ================= IMU ================= -->
    <link name="imu_link">
      <pose relative_to="chassis">0 0 0.10 0 0 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <imu>
          <angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z></angular_velocity>
          <linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z></linear_acceleration>
        </imu>
        <topic>/lunabot/imu</topic>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed"><parent>chassis</parent><child>imu_link</child></joint>

    <!-- ================= DIFFERENTIAL DRIVE ================= -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_middle_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_middle_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <wheel_separation>0.52</wheel_separation>
      <wheel_radius>0.115</wheel_radius>
      <max_linear_velocity>0.45</max_linear_velocity>
      <min_linear_velocity>-0.45</min_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity>
      <min_angular_velocity>-1.0</min_angular_velocity>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <max_angular_acceleration>1.8</max_angular_acceleration>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel</topic>
      <odom_topic>/lunabot/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>chassis</child_frame_id>
    </plugin>

    <!-- ================= CONTROLLERS ================= -->
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>left_front_steer_joint</joint_name><topic>/lunabot/steer/front_left</topic><p_gain>8</p_gain><i_gain>0.1</i_gain><d_gain>0.2</d_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>right_front_steer_joint</joint_name><topic>/lunabot/steer/front_right</topic><p_gain>8</p_gain><i_gain>0.1</i_gain><d_gain>0.2</d_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>left_rear_steer_joint</joint_name><topic>/lunabot/steer/rear_left</topic><p_gain>8</p_gain><i_gain>0.1</i_gain><d_gain>0.2</d_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>right_rear_steer_joint</joint_name><topic>/lunabot/steer/rear_right</topic><p_gain>8</p_gain><i_gain>0.1</i_gain><d_gain>0.2</d_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>mast_pan_joint</joint_name><topic>/lunabot/mast/pan</topic><p_gain>5</p_gain><i_gain>0.05</i_gain><d_gain>0.1</d_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>mast_tilt_joint</joint_name><topic>/lunabot/mast/tilt</topic><p_gain>5</p_gain><i_gain>0.05</i_gain><d_gain>0.1</d_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>left_front_wheel_joint</joint_name><joint_name>left_middle_wheel_joint</joint_name><joint_name>left_rear_wheel_joint</joint_name><joint_name>right_front_wheel_joint</joint_name><joint_name>right_middle_wheel_joint</joint_name><joint_name>right_rear_wheel_joint</joint_name><joint_name>left_front_steer_joint</joint_name><joint_name>right_front_steer_joint</joint_name><joint_name>left_rear_steer_joint</joint_name><joint_name>right_rear_steer_joint</joint_name><joint_name>left_rocker_joint</joint_name><joint_name>right_rocker_joint</joint_name><joint_name>left_bogie_joint</joint_name><joint_name>right_bogie_joint</joint_name><joint_name>mast_pan_joint</joint_name><joint_name>mast_tilt_joint</joint_name><topic>/lunabot/joint_states</topic>
    </plugin>
  </model>
</sdf>
