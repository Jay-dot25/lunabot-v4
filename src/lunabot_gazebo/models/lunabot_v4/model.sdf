<?xml version="1.0"?>
<sdf version="1.9">
  <model name="lunabot">
    <static>false</static>
    <self_collide>false</self_collide>
    <link name="base_link">
      <inertial><mass>18.0</mass><inertia><ixx>0.74</ixx><iyy>1.05</iyy><izz>1.42</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="chassis_collision"><geometry><box><size>0.72 0.48 0.20</size></box></geometry></collision>
      <visual name="chassis_visual"><geometry><box><size>0.72 0.48 0.20</size></box></geometry><material><ambient>0.62 0.64 0.65 1</ambient><diffuse>0.62 0.64 0.65 1</diffuse></material></visual>
      <visual name="top_deck"><pose>-0.02 0 0.13 0 0 0</pose><geometry><box><size>0.54 0.42 0.06</size></box></geometry><material><ambient>0.18 0.20 0.22 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material></visual>
    </link>

    <!-- Left/right driven wheels use the standard Gazebo DiffDrive system. -->
    <link name="left_wheel">
      <pose>0 0.29 -0.15 1.57079632679 0 0</pose>
      <inertial><mass>1.4</mass><inertia><ixx>0.012</ixx><iyy>0.012</iyy><izz>0.018</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="wheel_collision"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry><surface><friction><ode><mu>1.8</mu><mu2>1.8</mu2></ode></friction></surface></collision>
      <visual name="wheel_visual"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry><material><ambient>0.08 0.09 0.10 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-100000</lower><upper>100000</upper><effort>120</effort><velocity>18</velocity></limit><dynamics><damping>0.15</damping></dynamics></axis></joint>

    <link name="right_wheel">
      <pose>0 -0.29 -0.15 1.57079632679 0 0</pose>
      <inertial><mass>1.4</mass><inertia><ixx>0.012</ixx><iyy>0.012</iyy><izz>0.018</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="wheel_collision"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry><surface><friction><ode><mu>1.8</mu><mu2>1.8</mu2></ode></friction></surface></collision>
      <visual name="wheel_visual"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry><material><ambient>0.08 0.09 0.10 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material></visual>
    </link>
    <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-100000</lower><upper>100000</upper><effort>120</effort><velocity>18</velocity></limit><dynamics><damping>0.15</damping></dynamics></axis></joint>

    <!-- Small passive support rollers keep the chassis stable without steering joints. -->
    <link name="front_support"><pose>0.29 0 -0.235 0 0 0</pose><inertial><mass>0.3</mass><inertia><ixx>0.0007</ixx><iyy>0.0007</iyy><izz>0.0007</izz></inertia></inertial><collision name="support_collision"><geometry><sphere><radius>0.065</radius></sphere></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision><visual name="support_visual"><geometry><sphere><radius>0.065</radius></sphere></geometry><material><ambient>0.35 0.36 0.37 1</ambient></material></visual></link>
    <joint name="front_support_joint" type="fixed"><parent>base_link</parent><child>front_support</child></joint>
    <link name="rear_support"><pose>-0.29 0 -0.235 0 0 0</pose><inertial><mass>0.3</mass><inertia><ixx>0.0007</ixx><iyy>0.0007</iyy><izz>0.0007</izz></inertia></inertial><collision name="support_collision"><geometry><sphere><radius>0.065</radius></sphere></geometry><surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface></collision><visual name="support_visual"><geometry><sphere><radius>0.065</radius></sphere></geometry><material><ambient>0.35 0.36 0.37 1</ambient></material></visual></link>
    <joint name="rear_support_joint" type="fixed"><parent>base_link</parent><child>rear_support</child></joint>

    <link name="camera_link">
      <pose>0.28 0 0.32 0 0 0</pose>
      <inertial><mass>0.08</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial>
      <sensor name="front_camera" type="camera">
        <pose>0 0 0 0 0 0</pose><always_on>true</always_on><update_rate>15</update_rate><topic>/camera/image_raw</topic><gz_frame_id>camera_link</gz_frame_id>
        <camera><horizontal_fov>1.20</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.05</near><far>50</far></clip></camera>
      </sensor>
    </link>
    <joint name="camera_mount_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <link name="lidar_link">
      <pose>0 0 0.34 0 0 0</pose>
      <inertial><mass>0.10</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia></inertial>
      <sensor name="front_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose><always_on>true</always_on><update_rate>10</update_rate><topic>/scan</topic><gz_frame_id>lidar_link</gz_frame_id>
        <lidar><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal></scan><range><min>0.12</min><max>20.0</max><resolution>0.01</resolution></range></lidar>
      </sensor>
    </link>
    <joint name="lidar_mount_joint" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.58</wheel_separation><wheel_radius>0.15</wheel_radius>
      <max_linear_velocity>0.35</max_linear_velocity><min_linear_velocity>-0.35</min_linear_velocity>
      <max_angular_velocity>0.8</max_angular_velocity><min_angular_velocity>-0.8</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration><max_angular_acceleration>1.0</max_angular_acceleration>
      <odom_publish_frequency>30</odom_publish_frequency><topic>/lunabot/gz_cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name><topic>/joint_states</topic>
    </plugin>
  </model>
</sdf>
