<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lunar_world">

    <scene>
      <ambient>0.09 0.09 0.11 1</ambient>
      <background>0.002 0.002 0.005 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-5.2 -2.4 -1.15 0 0.22 0.18</pose>
        <clip>
          <near>0.15</near>
          <far>5000.0</far>
        </clip>
      </camera>
    </gui>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -1.62</gravity>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- Required for entity spawning (ign service -s /world/lunar_world/create) -->
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>

    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <!-- Fortress requires the world IMU system plugin for <sensor type="imu">. -->
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 200 0 0 0</pose>
      <diffuse>1.00 0.99 0.96 1</diffuse>
      <specular>0.28 0.28 0.26 1</specular>
      <direction>-0.58 -0.68 -0.45</direction>
    </light>

    <!-- ================= DEEP SPACE BLACK SKYDOME, STARFIELD & UPPER-LEFT CRESCENT EARTH ================= -->
    <model name="lunar_space_skybox">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="sky_link">
        <visual name="black_skydome_visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>file://meshes/lunar_black_skydome.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.003 0.003 0.006 1</ambient>
            <diffuse>0.003 0.003 0.006 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0.002 0.002 0.005 1</emissive>
          </material>
        </visual>
        <visual name="starfield_visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>file://meshes/lunar_starfield.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <emissive>0.96 0.98 1.0 1</emissive>
          </material>
        </visual>
        <visual name="earth_ocean_sphere">
          <cast_shadows>false</cast_shadows>
          <pose>125 36 32 0 0 0</pose>
          <geometry><sphere><radius>7.8</radius></sphere></geometry>
          <material>
            <ambient>0.10 0.32 0.76 1</ambient>
            <diffuse>0.16 0.48 0.94 1</diffuse>
            <specular>0.40 0.50 0.60 1</specular>
            <emissive>0.08 0.24 0.56 1</emissive>
          </material>
        </visual>
        <visual name="earth_continent_patch">
          <cast_shadows>false</cast_shadows>
          <pose>124.0 37.0 32.8 0.3 -0.4 0.5</pose>
          <geometry><sphere><radius>7.54</radius></sphere></geometry>
          <material>
            <ambient>0.26 0.48 0.28 1</ambient>
            <diffuse>0.34 0.58 0.34 1</diffuse>
            <emissive>0.12 0.24 0.14 1</emissive>
          </material>
        </visual>
        <visual name="earth_cloud_band">
          <cast_shadows>false</cast_shadows>
          <pose>123.8 36.2 31.8 -0.2 0.3 0.2</pose>
          <geometry><sphere><radius>7.64</radius></sphere></geometry>
          <material>
            <ambient>0.90 0.94 0.99 1</ambient>
            <diffuse>0.96 0.98 1.0 1</diffuse>
            <emissive>0.52 0.56 0.62 1</emissive>
          </material>
        </visual>
        <visual name="earth_night_terminator">
          <cast_shadows>false</cast_shadows>
          <pose>124.5 34.0 31.5 0 0 0</pose>
          <geometry><sphere><radius>7.74</radius></sphere></geometry>
          <material>
            <ambient>0.01 0.01 0.02 1</ambient>
            <diffuse>0.01 0.01 0.02 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0.005 0.005 0.01 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================================= -->
    <!-- TERRAIN REGIONS: 400m x 400m CONTINUOUS 3D REGOLITH, BEDROCK, ROCKS,      -->
    <!-- CRATER FIELDS, RIDGES, SLOPES & PERMANENT-SHADOW ZONES                    -->
    <!-- ========================================================================= -->
    <model name="lunar_terrain">
      <static>true</static>
      <link name="terrain_link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file://meshes/lunar_terrain_collision.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <mesh>
              <uri>file://meshes/lunar_terrain.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.34 0.34 0.36 1</ambient>
            <diffuse>0.58 0.58 0.60 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="lunar_foreground_regolith">
      <static>true</static>
      <pose>0 0 -2.79 0 0 0</pose>
      <link name="regolith_detail_link">
        <visual name="regolith_surface_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>file://meshes/lunar_impact_crater.obj</uri></mesh></geometry>
          <material>
            <ambient>0.44 0.44 0.46 1</ambient>
            <diffuse>0.76 0.76 0.78 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
            <pbr>
              <metal>
                <albedo_map>file://meshes/lunar_regolith_albedo.png</albedo_map>
                <roughness>0.96</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
        <visual name="angular_basalt_rocks_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>file://meshes/lunar_small_rocks.obj</uri></mesh></geometry>
          <material>
            <ambient>0.11 0.12 0.13 1</ambient>
            <diffuse>0.22 0.23 0.25 1</diffuse>
            <specular>0.08 0.08 0.09 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="lunar_exposed_bedrock">
      <static>true</static>
      <pose>0 0 -2.79 0 0 0</pose>
      <link name="bedrock_link">
        <visual name="exposed_bedrock_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>file://meshes/lunar_bedrock_patches.obj</uri></mesh></geometry>
          <material>
            <ambient>0.18 0.17 0.16 1</ambient>
            <diffuse>0.36 0.34 0.31 1</diffuse>
            <specular>0.08 0.08 0.07 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="lunar_dangerous_craters">
      <static>true</static>
      <pose>0 0 -2.79 0 0 0</pose>
      <link name="craters_link">
        <visual name="crater_ejecta_rims_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>file://meshes/lunar_route_crater_rim.obj</uri></mesh></geometry>
          <material>
            <ambient>0.34 0.34 0.36 1</ambient>
            <diffuse>0.60 0.60 0.63 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
        <visual name="crater_steep_walls_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>file://meshes/lunar_route_crater_wall.obj</uri></mesh></geometry>
          <material>
            <ambient>0.11 0.11 0.13 1</ambient>
            <diffuse>0.23 0.23 0.25 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="lunar_south_pole_shadows">
      <static>true</static>
      <pose>0 0 -2.79 0 0 0</pose>
      <link name="shadows_link">
        <visual name="deep_umbra_shadows_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>file://meshes/lunar_deep_shadows.obj</uri></mesh></geometry>
          <material>
            <ambient>0.005 0.005 0.008 1</ambient>
            <diffuse>0.008 0.008 0.012 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
        <visual name="penumbra_shadows_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>file://meshes/lunar_penumbra_shadows.obj</uri></mesh></geometry>
          <material>
            <ambient>0.05 0.05 0.07 1</ambient>
            <diffuse>0.10 0.10 0.13 1</diffuse>
            <specular>0.0 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="lunar_massif_horizon">
      <static>true</static>
      <pose>118.0 0.0 -1.40 0 0 0</pose>
      <link name="massif_link">
        <visual name="massif_visual">
          <cast_shadows>false</cast_shadows>
          <geometry><mesh><uri>file://meshes/lunar_massif_ridge.obj</uri></mesh></geometry>
          <material>
            <ambient>0.34 0.34 0.36 1</ambient>
            <diffuse>0.54 0.54 0.56 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================================================= -->
    <!-- LOCATION 1: LUNAR HABITAT HUB (CENTRAL SETTLEMENT BASE AT (-10.5, 7.5))   -->
    <!-- Main Habitat + Airlock + Rover Garage + Equipment Storage + EVA Area      -->
    <!-- ========================================================================= -->
    <model name="lunar_habitat_main">
      <static>true</static>
      <pose>-10.50 7.50 -2.772 0 0 -0.45</pose>
      <link name="habitat_body">
        <collision name="body_collision"><geometry><box><size>8.4 8.4 4.5</size></box></geometry></collision>
        <visual name="main_hab_skirt"><pose>0 0 0.70 0 0 0</pose><geometry><cylinder><radius>4.35</radius><length>1.40</length></cylinder></geometry><material><ambient>0.58 0.36 0.08 1</ambient><diffuse>0.82 0.54 0.14 1</diffuse></material></visual>
        <visual name="main_hab_cylinder"><pose>0 0 2.25 0 0 0</pose><geometry><cylinder><radius>4.20</radius><length>2.20</length></cylinder></geometry><material><ambient>0.76 0.77 0.79 1</ambient><diffuse>0.92 0.93 0.95 1</diffuse></material></visual>
        <visual name="main_hab_dome"><pose>0 0 3.25 0 0 0</pose><geometry><sphere><radius>4.15</radius></sphere></geometry><material><ambient>0.78 0.79 0.82 1</ambient><diffuse>0.94 0.95 0.97 1</diffuse></material></visual>
        <visual name="main_hab_tunnel"><pose>4.60 0 1.20 0 1.5708 0</pose><geometry><cylinder><radius>1.35</radius><length>3.60</length></cylinder></geometry><material><ambient>0.68 0.70 0.72 1</ambient><diffuse>0.84 0.86 0.88 1</diffuse></material></visual>
        <visual name="hub_beacon"><pose>0 0 7.60 0 0 0</pose><geometry><sphere><radius>0.18</radius></sphere></geometry><material><ambient>0.10 0.85 0.45 1</ambient><diffuse>0.15 0.98 0.55 1</diffuse><emissive>0.12 0.88 0.48 1</emissive></material></visual>
      </link>
    </model>

    <!-- Habitat Hub Rover Garage, Equipment Storage & Maintenance Area -->
    <model name="lunar_rover_garage">
      <static>true</static>
      <pose>-11.00 -4.50 -2.788 0 0 0.25</pose>
      <link name="garage_link">
        <visual name="garage_arch_shell"><pose>0 0 0.40 0 1.5708 0</pose><geometry><cylinder><radius>2.45</radius><length>5.60</length></cylinder></geometry><material><ambient>0.34 0.35 0.37 1</ambient><diffuse>0.52 0.53 0.55 1</diffuse></material></visual>
        <visual name="equipment_storage_rack_1"><pose>-0.80 3.20 0.55 0 0 0</pose><geometry><box><size>1.80 0.95 1.10</size></box></geometry><material><ambient>0.58 0.38 0.10 1</ambient><diffuse>0.82 0.56 0.16 1</diffuse></material></visual>
        <visual name="equipment_storage_rack_2"><pose>1.30 3.20 0.45 0 0 0</pose><geometry><box><size>1.50 0.95 0.90</size></box></geometry><material><ambient>0.24 0.28 0.32 1</ambient><diffuse>0.42 0.46 0.52 1</diffuse></material></visual>
        <visual name="maintenance_gantry"><pose>2.80 0 1.25 0 0 0</pose><geometry><box><size>0.18 3.20 2.50</size></box></geometry><material><ambient>0.65 0.67 0.70 1</ambient><diffuse>0.84 0.86 0.88 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Habitat Hub EVA Activity Area Astronaut -->
    <model name="lunar_astronaut_1">
      <static>true</static>
      <pose>-8.20 4.20 -2.570 0 0 -0.35</pose>
      <link name="astro1_link">
        <visual name="leg_left"><pose>0 0.11 0.42 0 0 0</pose><geometry><cylinder><radius>0.085</radius><length>0.84</length></cylinder></geometry><material><ambient>0.75 0.76 0.78 1</ambient><diffuse>0.88 0.89 0.91 1</diffuse></material></visual>
        <visual name="leg_right"><pose>0 -0.11 0.42 0 0 0</pose><geometry><cylinder><radius>0.085</radius><length>0.84</length></cylinder></geometry><material><ambient>0.75 0.76 0.78 1</ambient><diffuse>0.88 0.89 0.91 1</diffuse></material></visual>
        <visual name="torso"><pose>0 0 1.08 0 0 0</pose><geometry><box><size>0.32 0.42 0.54</size></box></geometry><material><ambient>0.78 0.79 0.81 1</ambient><diffuse>0.90 0.91 0.93 1</diffuse></material></visual>
        <visual name="plss_backpack"><pose>-0.22 0 1.12 0 0 0</pose><geometry><box><size>0.20 0.36 0.52</size></box></geometry><material><ambient>0.70 0.71 0.73 1</ambient><diffuse>0.84 0.85 0.87 1</diffuse></material></visual>
        <visual name="helmet"><pose>0 0 1.50 0 0 0</pose><geometry><sphere><radius>0.18</radius></sphere></geometry><material><ambient>0.82 0.83 0.85 1</ambient><diffuse>0.94 0.95 0.97 1</diffuse></material></visual>
        <visual name="gold_visor"><pose>0.05 0 1.50 0 0 0</pose><geometry><sphere><radius>0.155</radius></sphere></geometry><material><ambient>0.65 0.48 0.12 1</ambient><diffuse>0.85 0.65 0.16 1</diffuse><specular>0.85 0.75 0.30 1</specular></material></visual>
      </link>
    </model>

    <!-- Habitat Hub Navigation Reference Marker (Marks Safe Route-B Departure Corridor) -->
    <model name="lunar_habitat_equipment">
      <static>true</static>
      <pose>3.80 -2.20 -2.764 0 0 -0.42</pose>
      <link name="equipment_body">
        <collision name="equipment_collision"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>0.38 0.38 0.24</size></box></geometry></collision>
        <visual name="marker_base"><pose>0 0 0.14 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.28</length></cylinder></geometry><material><ambient>0.58 0.40 0.10 1</ambient><diffuse>0.82 0.56 0.16 1</diffuse></material></visual>
        <visual name="marker_pole"><pose>0 0 0.62 0 0 0</pose><geometry><cylinder><radius>0.028</radius><length>0.72</length></cylinder></geometry><material><ambient>0.70 0.72 0.75 1</ambient><diffuse>0.88 0.90 0.92 1</diffuse></material></visual>
        <visual name="beacon_light"><pose>0 0 1.02 0 0 0</pose><geometry><sphere><radius>0.065</radius></sphere></geometry><material><ambient>0.10 0.85 0.45 1</ambient><diffuse>0.15 0.98 0.55 1</diffuse><emissive>0.12 0.88 0.48 1</emissive></material></visual>
      </link>
    </model>

    <!-- ========================================================================= -->
    <!-- LOCATION 2: SOLAR POWER STATION (63.6m NE ON ELEVATED SUNLIT RIDGE)       -->
    <!-- Solar Panels + Power Control Unit + Energy Storage + Maintenance + Comms  -->
    <!-- ========================================================================= -->
    <model name="lunar_solar_power_station">
      <static>true</static>
      <pose>58.00 26.00 -0.979 0 0 0.42</pose>
      <link name="solar_station_link">
        <visual name="power_control_unit"><pose>0 0 0.65 0 0 0</pose><geometry><box><size>5.80 2.40 1.30</size></box></geometry><material><ambient>0.34 0.36 0.39 1</ambient><diffuse>0.54 0.56 0.60 1</diffuse></material></visual>
        <visual name="energy_storage_bank_1"><pose>-1.60 1.85 0.75 0 0 0</pose><geometry><box><size>2.10 1.25 1.50</size></box></geometry><material><ambient>0.58 0.38 0.08 1</ambient><diffuse>0.84 0.56 0.14 1</diffuse></material></visual>
        <visual name="energy_storage_bank_2"><pose>1.60 1.85 0.75 0 0 0</pose><geometry><box><size>2.10 1.25 1.50</size></box></geometry><material><ambient>0.58 0.38 0.08 1</ambient><diffuse>0.84 0.56 0.14 1</diffuse></material></visual>
        <visual name="solar_mast_1"><pose>-2.10 0 4.20 0 0 0</pose><geometry><cylinder><radius>0.10</radius><length>6.80</length></cylinder></geometry><material><ambient>0.70 0.72 0.75 1</ambient><diffuse>0.88 0.90 0.92 1</diffuse></material></visual>
        <visual name="solar_wing_1"><pose>-2.10 0 4.80 0 0 0.35</pose><geometry><box><size>0.08 2.80 4.60</size></box></geometry><material><ambient>0.10 0.22 0.58 1</ambient><diffuse>0.16 0.36 0.88 1</diffuse><specular>0.65 0.65 0.85 1</specular></material></visual>
        <visual name="solar_mast_2"><pose>0.0 0 4.20 0 0 0</pose><geometry><cylinder><radius>0.10</radius><length>6.80</length></cylinder></geometry><material><ambient>0.70 0.72 0.75 1</ambient><diffuse>0.88 0.90 0.92 1</diffuse></material></visual>
        <visual name="solar_wing_2"><pose>0.0 0 4.80 0 0 0.35</pose><geometry><box><size>0.08 2.80 4.60</size></box></geometry><material><ambient>0.10 0.22 0.58 1</ambient><diffuse>0.16 0.36 0.88 1</diffuse><specular>0.65 0.65 0.85 1</specular></material></visual>
        <visual name="solar_mast_3"><pose>2.10 0 4.20 0 0 0</pose><geometry><cylinder><radius>0.10</radius><length>6.80</length></cylinder></geometry><material><ambient>0.70 0.72 0.75 1</ambient><diffuse>0.88 0.90 0.92 1</diffuse></material></visual>
        <visual name="solar_wing_3"><pose>2.10 0 4.80 0 0 0.35</pose><geometry><box><size>0.08 2.80 4.60</size></box></geometry><material><ambient>0.10 0.22 0.58 1</ambient><diffuse>0.16 0.36 0.88 1</diffuse><specular>0.65 0.65 0.85 1</specular></material></visual>
        <visual name="small_comms_dish"><pose>2.60 -1.20 2.10 0 0.85 -0.4</pose><geometry><cylinder><radius>0.55</radius><length>0.08</length></cylinder></geometry><material><ambient>0.85 0.86 0.88 1</ambient><diffuse>0.95 0.96 0.98 1</diffuse></material></visual>
        <visual name="solar_station_beacon"><pose>0 0 7.75 0 0 0</pose><geometry><sphere><radius>0.22</radius></sphere></geometry><material><ambient>1.0 0.72 0.08 1</ambient><diffuse>1.0 0.82 0.12 1</diffuse><emissive>0.96 0.72 0.08 1</emissive></material></visual>
      </link>
    </model>

    <!-- ========================================================================= -->
    <!-- LOCATION 3: COMMUNICATION RELAY TOWER (108.8m NE ON HIGH PROMONTORY)      -->
    <!-- Elevated Landmark Relay Between Habitat Hub, Remote Areas & Science Base  -->
    <!-- ========================================================================= -->
    <model name="lunar_comms_relay_tower">
      <static>true</static>
      <pose>92.00 58.00 0.093 0 0 0</pose>
      <link name="tower_link">
        <visual name="relay_pedestal"><pose>0 0 0.65 0 0 0</pose><geometry><box><size>3.20 3.20 1.30</size></box></geometry><material><ambient>0.30 0.32 0.35 1</ambient><diffuse>0.48 0.50 0.54 1</diffuse></material></visual>
        <visual name="mast_pole"><pose>0 0 6.80 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>12.50</length></cylinder></geometry><material><ambient>0.65 0.66 0.68 1</ambient><diffuse>0.84 0.86 0.88 1</diffuse></material></visual>
        <visual name="earth_link_dish"><pose>-0.45 0.25 9.80 0.25 1.15 -0.35</pose><geometry><cylinder><radius>1.65</radius><length>0.16</length></cylinder></geometry><material><ambient>0.85 0.86 0.88 1</ambient><diffuse>0.95 0.96 0.98 1</diffuse><specular>0.4 0.4 0.4 1</specular></material></visual>
        <visual name="surface_relay_dish"><pose>0.42 -0.25 6.80 -0.20 1.25 2.40</pose><geometry><cylinder><radius>1.25</radius><length>0.14</length></cylinder></geometry><material><ambient>0.85 0.86 0.88 1</ambient><diffuse>0.95 0.96 0.98 1</diffuse></material></visual>
        <visual name="transceiver_shelter"><pose>1.80 0 0.95 0 0 0</pose><geometry><box><size>1.80 2.20 1.90</size></box></geometry><material><ambient>0.58 0.38 0.08 1</ambient><diffuse>0.82 0.56 0.14 1</diffuse></material></visual>
        <visual name="red_beacon_light"><pose>0 0 13.20 0 0 0</pose><geometry><sphere><radius>0.28</radius></sphere></geometry><material><ambient>1.0 0.08 0.08 1</ambient><diffuse>1.0 0.12 0.12 1</diffuse><emissive>1.0 0.10 0.10 1</emissive></material></visual>
      </link>
    </model>

    <!-- ========================================================================= -->
    <!-- LOCATION 4: SCIENCE / GEOLOGICAL STATION (82.9m ESE BEYOND ROCKY RIDGE)   -->
    <!-- Reached via Terrain-Aware Route B Around Crater Field & Rocky Ridge       -->
    <!-- ========================================================================= -->
    <model name="lunar_science_station">
      <static>true</static>
      <pose>78.00 -28.00 -1.347 0 0 2.75</pose>
