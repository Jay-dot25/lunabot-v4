<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lunar_world">
    
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -300 200 0 0.55 1.57</pose>
        <clip>
          <near>1.0</near>
          <far>5000.0</far>
        </clip>
      </camera>
    </gui>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <gravity>0 0 -1.62</gravity>

    <scene>
      <ambient>0.12 0.12 0.14 1</ambient>
      <background>0.01 0.01 0.02 1</background>
      <shadows>false</shadows>
    </scene>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 200 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.5 -0.6</direction>
    </light>

    <!-- ================= LUNAR TERRAIN ================= -->
    <model name="lunar_terrain">
      <static>true</static>
      <link name="terrain_link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file://meshes/lunar_terrain_collision.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file://meshes/lunar_terrain.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= LUNAR HABITAT - Cylindrical base + dome + airlock =================
         Implementation contract for PDF claim: rover navigates around lunar habitat.
         Base: cylinder radius 2.2m height 2.3m
         Dome: sphere radius 2.2m placed on top of base (hemisphere visible)
         Airlock: box 1.4x1.2x1.8m attached to +X side
         All have collision + visual geometry.
    -->
    <model name="lunar_habitat_main">
      <static>true</static>
      <pose>-3.5 3.5 -1.65 0 0 0</pose>
      <link name="habitat_body">
        <!-- Base cylindrical collision -->
        <collision name="base_collision">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>2.2</radius>
              <length>2.3</length>
            </cylinder>
          </geometry>
        </collision>
        <!-- Dome collision (sphere, conservative) -->
        <collision name="dome_collision">
          <pose>0 0 1.15 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>2.2</radius>
            </sphere>
          </geometry>
        </collision>
        <!-- Airlock collision -->
        <collision name="airlock_collision">
          <pose>2.4 0 -0.15 0 0 0</pose>
          <geometry>
            <box>
              <size>1.4 1.2 1.8</size>
            </box>
          </geometry>
        </collision>
        <!-- Visual: cylindrical base -->
        <visual name="base_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>2.2</radius>
              <length>2.3</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.32 0.36 0.42 1</ambient>
            <diffuse>0.32 0.36 0.42 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
        <!-- Visual: dome (sphere) -->
        <visual name="dome_visual">
          <pose>0 0 1.15 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>2.2</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.55 0.60 0.68 1</ambient>
            <diffuse>0.55 0.60 0.68 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
        <!-- Visual: airlock -->
        <visual name="airlock_visual">
          <pose>2.4 0 -0.15 0 0 0</pose>
          <geometry>
            <box>
              <size>1.4 1.2 1.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.38 0.40 0.45 1</ambient>
            <diffuse>0.38 0.40 0.45 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <!-- Visual: window on base -->
        <visual name="window_front">
          <pose>0 -2.19 0.15 0 0 0</pose>
          <geometry>
            <box>
              <size>1.2 0.04 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.08 0.25 0.35 1</ambient>
            <diffuse>0.08 0.25 0.35 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <!-- Visual: airlock door -->
        <visual name="airlock_door">
          <pose>3.11 0 -0.15 0 0 0</pose>
          <geometry>
            <box>
              <size>0.08 0.9 1.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.20 0.22 1</ambient>
            <diffuse>0.18 0.20 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <!-- Visual: antenna -->
        <visual name="antenna">
          <pose>0 0 3.4 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.05</radius>
              <length>1.2</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="lunar_habitat_equipment">
      <static>true</static>
      <pose>-3.0 -2.8 -2.18 0 0 0</pose>
      <link name="equipment_body">
        <collision name="equipment_collision"><geometry><box><size>2.2 1.5 1.2</size></box></geometry></collision>
        <visual name="equipment_visual"><geometry><box><size>2.2 1.5 1.2</size></box></geometry><material><ambient>0.48 0.30 0.12 1</ambient><diffuse>0.48 0.30 0.12 1</diffuse></material></visual>
        <visual name="panel"><pose>0 0 0.72 0.25 0 0</pose><geometry><box><size>1.8 0.04 0.65</size></box></geometry><material><ambient>0.04 0.12 0.22 1</ambient><diffuse>0.04 0.12 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="presentation_obstacle_forward">
      <static>true</static>
      <pose>2.0 0.0 -2.39 0 0 0</pose>
      <link name="obstacle_body">
        <collision name="obstacle_collision"><geometry><box><size>0.95 0.95 0.80</size></box></geometry></collision>
        <visual name="obstacle_visual"><geometry><box><size>0.95 0.95 0.80</size></box></geometry><material><ambient>0.88 0.27 0.05 1</ambient><diffuse>0.88 0.27 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= 8 ROCK PROPS - physically distinct objects ================= -->
    <model name="presentation_rock_01">
      <static>true</static>
      <pose>1.4 2.1 -2.48 0 0 0</pose>
      <link name="rock_body">
        <collision name="rock_collision"><geometry><sphere><radius>0.55</radius></sphere></geometry></collision>
        <visual name="rock_visual"><geometry><sphere><radius>0.55</radius></sphere></geometry><material><ambient>0.28 0.29 0.30 1</ambient><diffuse>0.28 0.29 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <model name="presentation_rock_02">
      <static>true</static>
      <pose>-1.2 4.5 -2.35 0 0 0</pose>
      <link name="rock_body">
        <collision name="rock_collision"><geometry><sphere><radius>0.40</radius></sphere></geometry></collision>
        <visual name="rock_visual"><geometry><sphere><radius>0.40</radius></sphere></geometry><material><ambient>0.30 0.31 0.32 1</ambient><diffuse>0.30 0.31 0.32 1</diffuse></material></visual>
      </link>
    </model>

    <model name="presentation_rock_03">
      <static>true</static>
      <pose>3.5 -1.5 -2.40 0 0 0</pose>
      <link name="rock_body">
        <collision name="rock_collision"><geometry><box><size>0.8 0.7 0.6</size></box></geometry></collision>
        <visual name="rock_visual"><geometry><box><size>0.8 0.7 0.6</size></box></geometry><material><ambient>0.32 0.33 0.34 1</ambient><diffuse>0.32 0.33 0.34 1</diffuse></material></visual>
      </link>
    </model>

    <model name="presentation_rock_04">
      <static>true</static>
      <pose>-2.0 -3.5 -2.30 0 0 0</pose>
      <link name="rock_body">
        <collision name="rock_collision"><geometry><sphere><radius>0.35</radius></sphere></geometry></collision>
        <visual name="rock_visual"><geometry><sphere><radius>0.35</radius></sphere></geometry><material><ambient>0.27 0.28 0.29 1</ambient><diffuse>0.27 0.28 0.29 1</diffuse></material></visual>
      </link>
    </model>

    <model name="presentation_rock_05">
      <static>true</static>
      <pose>4.0 2.5 -2.45 0 0 0</pose>
      <link name="rock_body">
        <collision name="rock_collision"><geometry><sphere><radius>0.50</radius></sphere></geometry></collision>
        <visual name="rock_visual"><geometry><sphere><radius>0.50</radius></sphere></geometry><material><ambient>0.29 0.30 0.31 1</ambient><diffuse>0.29 0.30 0.31 1</diffuse></material></visual>
      </link>
    </model>

    <model name="presentation_rock_06">
      <static>true</static>
      <pose>0.5 -4.0 -2.35 0 0 0</pose>
      <link name="rock_body">
        <collision name="rock_collision"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="rock_visual"><geometry><box><size>0.6 0.6 0.5</size></box></geometry><material><ambient>0.31 0.32 0.33 1</ambient><diffuse>0.31 0.32 0.33 1</diffuse></material></visual>
      </link>
    </model>

    <model name="presentation_rock_07">
      <static>true</static>
      <pose>-4.5 0.5 -2.30 0 0 0</pose>
      <link name="rock_body">
        <collision name="rock_collision"><geometry><sphere><radius>0.60</radius></sphere></geometry></collision>
        <visual name="rock_visual"><geometry><sphere><radius>0.60</radius></sphere></geometry><material><ambient>0.26 0.27 0.28 1</ambient><diffuse>0.26 0.27 0.28 1</diffuse></material></visual>
      </link>
    </model>

    <model name="presentation_rock_08">
      <static>true</static>
      <pose>2.5 4.0 -2.50 0 0 0</pose>
      <link name="rock_body">
        <collision name="rock_collision"><geometry><sphere><radius>0.40</radius></sphere></geometry></collision>
        <visual name="rock_visual"><geometry><sphere><radius>0.40</radius></sphere></geometry><material><ambient>0.33 0.34 0.35 1</ambient><diffuse>0.33 0.34 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= HORIZON CATCH PLANE ================= -->
    <model name="lunar_horizon">
      <static>true</static>
      <link name="horizon_link">
        <collision name="horizon_collision">
          <pose>0 0 -12.4 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <center>800 800</center>
            </plane>
          </geometry>
        </collision>
        <visual name="horizon_visual">
          <pose>0 0 -12.4 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <center>800 800</center>
            </plane>
          </geometry>
          <material>
            <ambient>0.42 0.42 0.42 1</ambient>
            <diffuse>0.42 0.42 0.42 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
