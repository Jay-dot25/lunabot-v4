<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lunar_base_camp">
    <gravity>0 0 -1.62</gravity>
    <physics name="fast_physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>

    <scene><ambient>0.28 0.28 0.30 1</ambient><background>0.025 0.03 0.045 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 15 0 0 0</pose><diffuse>0.85 0.82 0.75 1</diffuse><specular>0.18 0.18 0.18 1</specular><direction>-0.45 0.35 -0.82</direction></light>

    <model name="lunar_ground"><static>true</static><link name="ground_link">
      <collision name="ground_collision"><geometry><box><size>30 30 0.10</size></box></geometry><surface><friction><ode><mu>1.6</mu><mu2>1.6</mu2></ode></friction></surface></collision>
      <visual name="ground_visual"><geometry><box><size>30 30 0.10</size></box></geometry><material><ambient>0.24 0.25 0.27 1</ambient><diffuse>0.31 0.32 0.34 1</diffuse></material></visual>
    </link><pose>0 0 -0.05 0 0 0</pose></model>

    <!-- Fixed, collision-bearing rocks for repeatable camera/LiDAR trials. -->
    <model name="rock_a"><static>true</static><pose>3.0 0 0.38 0.1 0.15 0</pose><link name="rock"><collision name="collision"><geometry><box><size>0.75 0.85 0.76</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.75 0.85 0.76</size></box></geometry><material><ambient>0.28 0.29 0.30 1</ambient><diffuse>0.28 0.29 0.30 1</diffuse></material></visual></link></model>
    <model name="rock_b"><static>true</static><pose>5.3 2.7 0.50 0.2 0.1 0.35</pose><link name="rock"><collision name="collision"><geometry><sphere><radius>0.58</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.58</radius></sphere></geometry><material><ambient>0.34 0.34 0.35 1</ambient><diffuse>0.34 0.34 0.35 1</diffuse></material></visual></link></model>
    <model name="rock_c"><static>true</static><pose>6.5 -2.2 0.28 0 0.2 0</pose><link name="rock"><collision name="collision"><geometry><box><size>0.55 0.62 0.56</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.55 0.62 0.56</size></box></geometry><material><ambient>0.20 0.21 0.23 1</ambient><diffuse>0.20 0.21 0.23 1</diffuse></material></visual></link></model>
    <model name="rock_d"><static>true</static><pose>-3.8 3.0 0.42 0 0 0.2</pose><link name="rock"><collision name="collision"><geometry><sphere><radius>0.48</radius></sphere></geometry></collision><visual name="visual"><geometry><sphere><radius>0.48</radius></sphere></geometry><material><ambient>0.30 0.30 0.31 1</ambient><diffuse>0.30 0.30 0.31 1</diffuse></material></visual></link></model>
    <model name="rock_e"><static>true</static><pose>-5.6 -2.5 0.22 0.1 0 0</pose><link name="rock"><collision name="collision"><geometry><box><size>0.65 0.65 0.44</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.65 0.65 0.44</size></box></geometry><material><ambient>0.25 0.26 0.27 1</ambient><diffuse>0.25 0.26 0.27 1</diffuse></material></visual></link></model>

    <include><uri>model://lunabot_v4</uri><name>lunabot</name><pose>0 0 0.30 0 0 0</pose></include>
  </world>
</sdf>
