<?xml version="1.0"?>
<sdf version="1.9">
  <world name="lunar_world">
    
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -300 200 0 0.55 1.57</pose>
        <clip>
          <near>1.0</near>
          <far>5000.0</far>
        </clip>
      </camera>
    </gui>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <gravity>0 0 -1.62</gravity>

    <!-- Low-contrast, near-black lunar lighting.  Shadows are disabled both
         here and on the sun so camera output is reproducible headlessly. -->
    <scene>
      <ambient>0.12 0.12 0.14 1</ambient>
      <background>0.01 0.01 0.02 1</background>
      <shadows>false</shadows>
    </scene>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    
    <!-- Required for entity spawning (ign service -s /world/lunar_world/create) -->
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
    <!-- Fortress requires the world IMU system plugin for <sensor type="imu">. -->
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 200 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.5 0.5 -0.6</direction>
    </light>

    <!-- ================= LUNAR TERRAIN =================
         Generated by tools/generate_lunar_terrain.py (deterministic, seed 42).
         - Visual mesh:  320x320 grid, 1.25 m, per-vertex grey albedo (~16 MB)
         - Collision mesh: 100x100 grid, 4 m (~1.2 MB, fast physics)
         file:// URIs resolve against GZ_SIM_RESOURCE_PATH / IGN_GAZEBO_RESOURCE_PATH,
         which launch-a.sh sets to this directory (src/lunabot_gazebo/worlds).
    -->
    <model name="lunar_terrain">
      <static>true</static>
      <link name="terrain_link">
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file://meshes/lunar_terrain_collision.obj</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file://meshes/lunar_terrain.obj</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= LUNAR HABITAT PRESENTATION SET =================
         Static visual/collision landmarks make the final demonstration read as
         a lunar habitat mission rather than an empty terrain regression. The
         forward obstacle is deliberately placed on a useful demonstration
         route so LiDAR/depth can detect it as a real Gazebo collision object.
    -->
    <model name="lunar_habitat">
      <static>true</static>
      <!-- The generated spawn pad is near z=-2.8 m.  The base bottom sits at
           z=-2.75 m, leaving a small tolerance for the coarse collision mesh. -->
      <pose>-3.5 4.5 -1.35 0 0 0</pose>
      <link name="habitat_structure">
        <!-- 5 m diameter pressure-vessel base: a physical navigation obstacle. -->
        <collision name="base_collision">
          <geometry><cylinder><radius>2.5</radius><length>2.8</length></cylinder></geometry>
        </collision>
        <visual name="base_visual">
          <geometry><cylinder><radius>2.5</radius><length>2.8</length></cylinder></geometry>
          <material><ambient>0.46 0.49 0.54 1</ambient><diffuse>0.46 0.49 0.54 1</diffuse><specular>0.12 0.12 0.12 1</specular></material>
        </visual>

        <!-- Native SDF has no hemisphere primitive.  The lower half of this
             collision sphere overlaps the cylindrical pressure vessel, while
             the exposed upper half forms a robust physical dome. -->
        <collision name="dome_collision">
          <pose>0 0 1.35 0 0 0</pose>
          <geometry><sphere><radius>2.48</radius></sphere></geometry>
        </collision>
        <visual name="dome_visual">
          <pose>0 0 1.35 0 0 0</pose>
          <geometry><sphere><radius>2.48</radius></sphere></geometry>
          <material><ambient>0.62 0.65 0.70 1</ambient><diffuse>0.62 0.65 0.70 1</diffuse><specular>0.18 0.18 0.18 1</specular></material>
        </visual>

        <!-- Horizontal airlock projects toward the rover side of the habitat. -->
        <collision name="airlock_collision">
          <pose>0 -2.75 -0.15 1.570796 0 0</pose>
          <geometry><cylinder><radius>0.85</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="airlock_visual">
          <pose>0 -2.75 -0.15 1.570796 0 0</pose>
          <geometry><cylinder><radius>0.85</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.28 0.31 0.36 1</ambient><diffuse>0.28 0.31 0.36 1</diffuse></material>
        </visual>
        <visual name="airlock_door">
          <pose>0 -3.51 -0.15 1.570796 0 0</pose>
          <geometry><cylinder><radius>0.68</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.10 0.20 0.27 1</ambient><diffuse>0.10 0.20 0.27 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lunar_habitat_equipment">
      <static>true</static>
      <pose>-3.0 -2.8 -2.18 0 0 0</pose>
      <link name="equipment_body">
        <collision name="equipment_collision"><geometry><box><size>2.2 1.5 1.2</size></box></geometry></collision>
        <visual name="equipment_visual"><geometry><box><size>2.2 1.5 1.2</size></box></geometry><material><ambient>0.48 0.30 0.12 1</ambient><diffuse>0.48 0.30 0.12 1</diffuse></material></visual>
        <visual name="panel"><pose>0 0 0.72 0.25 0 0</pose><geometry><box><size>1.8 0.04 0.65</size></box></geometry><material><ambient>0.04 0.12 0.22 1</ambient><diffuse>0.04 0.12 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="presentation_obstacle_forward">
      <static>true</static>
      <pose>2.0 0.0 -2.39 0 0 0</pose>
      <link name="obstacle_body">
        <collision name="obstacle_collision"><geometry><box><size>0.95 0.95 0.80</size></box></geometry></collision>
        <visual name="obstacle_visual"><geometry><box><size>0.95 0.95 0.80</size></box></geometry><material><ambient>0.88 0.27 0.05 1</ambient><diffuse>0.88 0.27 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <model name="presentation_rock_left">
      <static>true</static>
      <pose>1.4 2.1 -2.48 0 0 0</pose>
      <link name="rock_body">
        <collision name="rock_collision"><geometry><sphere><radius>0.55</radius></sphere></geometry></collision>
        <visual name="rock_visual"><geometry><sphere><radius>0.55</radius></sphere></geometry><material><ambient>0.28 0.29 0.30 1</ambient><diffuse>0.28 0.29 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================= HORIZON CATCH PLANE =================
         Keeps the world from ending in a void if the rover drives beyond the
         terrain mesh edge (400 m x 400 m crater field). Sits ~3 m below the
         lowest crater floor, so it is never visible inside the crater field.
    -->
    <model name="lunar_horizon">
      <static>true</static>
      <link name="horizon_link">
        <collision name="horizon_collision">
          <pose>0 0 -12.4 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <center>800 800</center>
            </plane>
          </geometry>
        </collision>
        <visual name="horizon_visual">
          <pose>0 0 -12.4 0 0 0</pose>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <center>800 800</center>
            </plane>
          </geometry>
          <material>
            <ambient>0.42 0.42 0.42 1</ambient>
            <diffuse>0.42 0.42 0.42 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
