<?xml version="1.0"?>
<!--
  LunaBot V4 rover model.

  Design rules (see docs/project-synopsis.md):
    * Motion estimates used by the navigation stack come from WHEEL ODOMETRY
      published by the DiffDrive plugin (/lunabot/odom). No component may read
      simulator ground-truth pose to operate.
    * A PosePublisher is attached ONLY to provide an evaluation-only reference
      stream (/model/lunabot_v4/pose) for test reports. It is never consumed
      by the controller, mapper or planner.
  Frames: base_link is the model root. Sensor frames lunabot_camera,
  lunabot_lidar and lunabot_imu are declared on the sensors (<gz_frame_id>)
  and mirrored by static transforms in the bringup launch/script.
-->
<sdf version="1.9">
  <model name="lunabot_v4">

    <!-- ============================== BASE ============================== -->
    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>50.0</mass>
        <inertia>
          <ixx>1.7604</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.4271</iyy>
          <iyz>0</iyz>
          <izz>5.6667</izz>
        </inertia>
      </inertial>

      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>1.00 0.60 0.25</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.88 1</ambient>
          <diffuse>0.85 0.85 0.88 1</diffuse>
          <specular>0.30 0.30 0.32 1</specular>
        </material>
      </visual>

      <!-- Gold-foil accent panel, like a real lunar lander/rover -->
      <visual name="foil_visual">
        <pose>0 0 0.130 0 0 0</pose>
        <geometry>
          <box>
            <size>0.60 0.50 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.80 0.55 0.15 1</ambient>
          <diffuse>0.85 0.60 0.18 1</diffuse>
          <specular>0.60 0.45 0.15 1</specular>
        </material>
      </visual>

      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>1.00 0.60 0.25</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <!-- ============================== WHEELS ============================
      Wheel links are rolled +90 deg about X so the cylinder axis (link Z)
      lies along the rover's lateral axis. Wheel centres sit at z = 0 of the
      base frame, giving 25 mm chassis ground clearance with r = 0.15 wheels.
    -->
    <link name="front_left_wheel_link">
      <pose>0.35 0.40 0 1.5708 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0194</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0194</iyy>
          <iyz>0</iyz>
          <izz>0.0338</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.20 0.20 0.22 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="rear_left_wheel_link">
      <pose>-0.35 0.40 0 1.5708 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0194</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0194</iyy>
          <iyz>0</iyz>
          <izz>0.0338</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.20 0.20 0.22 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="front_right_wheel_link">
      <pose>0.35 -0.40 0 1.5708 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0194</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0194</iyy>
          <iyz>0</iyz>
          <izz>0.0338</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.20 0.20 0.22 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <link name="rear_right_wheel_link">
      <pose>-0.35 -0.40 0 1.5708 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0194</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0194</iyy>
          <iyz>0</iyz>
          <izz>0.0338</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.20 0.20 0.22 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
          <velocity>30.0</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
          <velocity>30.0</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
          <velocity>30.0</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
          <velocity>30.0</velocity>
        </limit>
        <dynamics>
          <damping>0.05</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ============================ SENSOR MAST ========================= -->
    <link name="sensor_mast">
      <pose>0 0 0.40 0 0 0</pose>
      <inertial>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.1237</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.1237</iyy>
          <iyz>0</iyz>
          <izz>0.0024</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.55</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.30 0.30 0.32 1</ambient>
          <diffuse>0.35 0.35 0.38 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.55</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="sensor_mast_joint" type="fixed">
      <parent>base_link</parent>
      <child>sensor_mast</child>
    </joint>

    <!-- ============================ SENSOR HEAD ========================= -->
    <link name="sensor_head">
      <pose>0.08 0 0.725 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0045</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0125</iyy>
          <iyz>0</iyz>
          <izz>0.0145</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.30 0.16 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.28 1</ambient>
          <diffuse>0.30 0.30 0.33 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.30 0.16 0.10</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="sensor_head_joint" type="fixed">
      <parent>sensor_mast</parent>
      <child>sensor_head</child>
    </joint>

    <!-- ============================= SENSORS ============================ -->

    <!-- RGB camera: the Phase 2 "Eyes of Luna" input stream -->
    <sensor name="lunabot_camera" type="camera">
      <pose>0.12 0 0 0 0 0</pose>
      <gz_frame_id>lunabot_camera</gz_frame_id>
      <topic>/lunabot/camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>100.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
    </sensor>

    <!-- 360-degree LiDAR: the geometric mapping / hazard input stream -->
    <sensor name="lunabot_lidar" type="gpu_lidar">
      <pose>0 0 0.11 0 0 0</pose>
      <gz_frame_id>lunabot_lidar</gz_frame_id>
      <topic>/lunabot/lidar/scan</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>40.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
    </sensor>

    <!-- IMU: supplementary motion information -->
    <sensor name="lunabot_imu" type="imu">
      <pose>0 0 0.05 0 0 0</pose>
      <gz_frame_id>lunabot_imu</gz_frame_id>
      <topic>/lunabot/imu</topic>
      <always_on>true</always_on>
      <update_rate>50</update_rate>
    </sensor>

    <!-- ============================ PLUGINS ============================= -->

    <!--
      DiffDrive: skid-steer control from /cmd_vel and WHEEL ODOMETRY on
      /lunabot/odom (motion estimate, not ground truth).
    -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.80</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/lunabot/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!--
      PosePublisher: EVALUATION-ONLY ground-truth reference on
      /model/lunabot_v4/pose. Never consumed by the navigation stack.
    -->
    <plugin filename="ignition-gazebo-pose-publisher-system" name="ignition::gazebo::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>true</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
    </plugin>

  </model>
</sdf>
