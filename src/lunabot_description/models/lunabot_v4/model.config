<?xml version="1.0"?>
<model>
  <name>lunabot_v4</name>
  <version>0.1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>LunaBot Team</name>
    <email>ops@lunabot.local</email>
  </author>
  <description>
    LunaBot V4 lunar rover: skid-steer mobile base with sensor mast carrying
    an RGB camera and a 360-degree LiDAR, plus a chassis IMU. Motion estimates
    come from wheel odometry (DiffDrive plugin), never from simulator
    ground-truth pose.
  </description>
</model>
