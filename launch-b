#!/bin/bash
# ============================================================
#  LunaBot V4 - Phase B entry point
#  Canonical command:  ~/launch-b
#
#  The readlink resolution is required because ~/launch-b is a symlink
#  to this repository entry point.
# ============================================================
SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
exec "$(cd "$(dirname "$SCRIPT")" && pwd)/scripts/launch-b.sh" "$@"
