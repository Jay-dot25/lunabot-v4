{
  "schema_version": 1,
  "task": "eyes_of_luna",
  "camera": {
    "topic": "/camera/image_raw",
    "source_resolution": [640, 480],
    "color_order": "RGB"
  },
  "terrain_head": {
    "output_channels": 4,
    "activation": "softmax",
    "class_ids": {
      "0": "regolith",
      "1": "bedrock",
      "2": "rock_boulder",
      "3": "crater"
    },
    "ignore_id": 255
  },
  "shadow_head": {
    "output_channels": 1,
    "activation": "sigmoid",
    "negative_id": 0,
    "positive_id": 1,
    "ignore_id": 255,
    "independent_of_terrain": true
  },
  "dataset": {
    "schema": "eyes_of_luna_camera_v1",
    "group_split_required": true,
    "human_review_required_for_each_head": true
  }
}
