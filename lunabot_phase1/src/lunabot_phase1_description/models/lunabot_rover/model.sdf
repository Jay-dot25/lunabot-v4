<?xml version="1.0"?>
<sdf version="1.8">
  <model name="lunabot_rover">
    <static>false</static>

    <!--
      Mechanical reference dimensions (metres): chassis 0.74 x 0.56 x 0.22,
      wheel radius 0.16, wheel separation 0.62. The corresponding controller
      limits are repeated in the ROS command_guard config and kept in sync by
      the static project tests. This is a simulation model, not flight hardware.
    -->
    <link name="base_link">
      <!-- base_link origin is the chassis centre; base_footprint is at z = 0. -->
      <pose>0 0 0.32 0 0 0</pose>
      <inertial>
        <mass>14.0</mass>
        <inertia>
          <ixx>0.41</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.71</iyy><iyz>0</iyz><izz>1.01</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>0.74 0.56 0.22</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><box><size>0.74 0.56 0.22</size></box></geometry>
        <material>
          <ambient>0.66 0.67 0.64 1</ambient>
          <diffuse>0.72 0.73 0.70 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
        </material>
      </visual>
      <visual name="upper_deck_visual">
        <pose>-0.02 0 0.13 0 0 0</pose>
        <geometry><box><size>0.58 0.45 0.06</size></box></geometry>
        <material>
          <ambient>0.20 0.23 0.25 1</ambient>
          <diffuse>0.25 0.28 0.30 1</diffuse>
        </material>
      </visual>
      <visual name="lidar_mast_visual">
        <pose>0.06 0 0.15 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.20</length></cylinder></geometry>
        <material>
          <ambient>0.54 0.43 0.24 1</ambient>
          <diffuse>0.64 0.52 0.30 1</diffuse>
        </material>
      </visual>
      <visual name="solar_panel_visual">
        <pose>-0.02 0 0.166 0 0 0</pose>
        <geometry><box><size>0.40 0.38 0.012</size></box></geometry>
        <material>
          <ambient>0.08 0.16 0.24 1</ambient>
          <diffuse>0.10 0.22 0.34 1</diffuse>
          <specular>0.22 0.28 0.34 1</specular>
        </material>
      </visual>
      <visual name="front_bumper_visual">
        <pose>0.385 0 -0.015 0 0 0</pose>
        <geometry><box><size>0.08 0.60 0.07</size></box></geometry>
        <material>
          <ambient>0.55 0.20 0.04 1</ambient>
          <diffuse>0.78 0.30 0.06 1</diffuse>
        </material>
      </visual>
      <!-- Low-friction skid balls support the front and rear of this two-wheel
           chassis. Without them, the single driven axle is pitch-unstable. -->
      <collision name="front_stabilizer_skid_collision">
        <pose>0.28 0 -0.24 0 0 0</pose>
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <surface>
          <friction>
            <ode><mu>0.08</mu><mu2>0.08</mu2><slip1>0.10</slip1><slip2>0.10</slip2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="front_stabilizer_skid_visual">
        <pose>0.28 0 -0.24 0 0 0</pose>
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><ambient>0.10 0.10 0.11 1</ambient><diffuse>0.14 0.14 0.15 1</diffuse></material>
      </visual>
      <collision name="rear_stabilizer_skid_collision">
        <pose>-0.28 0 -0.24 0 0 0</pose>
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <surface>
          <friction>
            <ode><mu>0.08</mu><mu2>0.08</mu2><slip1>0.10</slip1><slip2>0.10</slip2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="rear_stabilizer_skid_visual">
        <pose>-0.28 0 -0.24 0 0 0</pose>
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
        <material><ambient>0.10 0.10 0.11 1</ambient><diffuse>0.14 0.14 0.15 1</diffuse></material>
      </visual>
    </link>

    <!-- Left and right wheels have true revolute joints and physical contact. -->
    <link name="left_wheel">
      <pose>0 0.31 0.16 1.57079632679 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0109</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0109</iyy><iyz>0</iyz><izz>0.0192</izz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <geometry><cylinder><radius>0.16</radius><length>0.12</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.5</mu><mu2>1.5</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="wheel_visual">
        <geometry><cylinder><radius>0.16</radius><length>0.12</length></cylinder></geometry>
        <material>
          <ambient>0.09 0.09 0.10 1</ambient>
          <diffuse>0.13 0.13 0.14 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis>
        <!-- Wheel link is rotated so its local Z axis is the lateral axle. -->
        <xyz>0 0 1</xyz>
        <limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>80</effort><velocity>25</velocity></limit>
        <dynamics><damping>0.02</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <link name="right_wheel">
      <pose>0 -0.31 0.16 1.57079632679 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0109</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0109</iyy><iyz>0</iyz><izz>0.0192</izz>
        </inertia>
      </inertial>
      <collision name="wheel_collision">
        <geometry><cylinder><radius>0.16</radius><length>0.12</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.5</mu><mu2>1.5</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="wheel_visual">
        <geometry><cylinder><radius>0.16</radius><length>0.12</length></cylinder></geometry>
        <material>
          <ambient>0.09 0.09 0.10 1</ambient>
          <diffuse>0.13 0.13 0.14 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>80</effort><velocity>25</velocity></limit>
        <dynamics><damping>0.02</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <!-- The camera looks along local +X; ROS image headers use the optical frame. -->
    <link name="camera_link">
      <pose relative_to="base_link">0.40 0 0.28 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
      </inertial>
      <visual name="camera_housing_visual">
        <!-- Keep the housing behind the optical centre so it cannot block the image. -->
        <pose>-0.06 0 0 0 0 0</pose>
        <geometry><box><size>0.12 0.11 0.08</size></box></geometry>
        <material>
          <ambient>0.16 0.19 0.22 1</ambient>
          <diffuse>0.20 0.24 0.27 1</diffuse>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>20</update_rate>
        <topic>/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.04719755</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip>
          <optical_frame_id>camera_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </link>
    <joint name="camera_mount_joint" type="fixed">
      <parent>base_link</parent><child>camera_link</child>
    </joint>

    <!-- Horizontal 360-degree range scan, centred at rover-forward +X. -->
    <link name="lidar_link">
      <pose relative_to="base_link">0.06 0 0.20 0 0 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia><ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0005</iyy><iyz>0</iyz><izz>0.0005</izz></inertia>
      </inertial>
      <visual name="lidar_housing_visual">
        <geometry><cylinder><radius>0.075</radius><length>0.055</length></cylinder></geometry>
        <material>
          <ambient>0.23 0.24 0.25 1</ambient>
          <diffuse>0.28 0.29 0.30 1</diffuse>
        </material>
      </visual>
      <sensor name="front_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>/scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples><resolution>1</resolution>
              <min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min><max>15.0</max><resolution>0.01</resolution>
          </range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
        </ray>
      </sensor>
    </link>
    <joint name="lidar_mount_joint" type="fixed">
      <parent>base_link</parent><child>lidar_link</child>
    </joint>

    <!-- One Gazebo DiffDrive system owns wheel control and wheel-model odometry. -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.62</wheel_separation>
      <wheel_radius>0.16</wheel_radius>
      <topic>/cmd_vel_sim</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <min_linear_velocity>-0.35</min_linear_velocity>
      <max_linear_velocity>0.35</max_linear_velocity>
      <min_angular_velocity>-0.80</min_angular_velocity>
      <max_angular_velocity>0.80</max_angular_velocity>
      <min_linear_acceleration>-0.40</min_linear_acceleration>
      <max_linear_acceleration>0.40</max_linear_acceleration>
      <min_angular_acceleration>-0.90</min_angular_acceleration>
      <max_angular_acceleration>0.90</max_angular_acceleration>
    </plugin>
  </model>
</sdf>
