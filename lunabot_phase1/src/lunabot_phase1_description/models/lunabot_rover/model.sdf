        <pose>0.00000 0.14500 0 0 0 1.57080</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_front_wheel_tread_lug_3">
        <pose>-0.10253 0.10253 0 0 0 2.35619</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_front_wheel_tread_lug_4">
        <pose>-0.14500 0.00000 0 0 0 3.14159</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_front_wheel_tread_lug_5">
        <pose>-0.10253 -0.10253 0 0 0 3.92699</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_front_wheel_tread_lug_6">
        <pose>-0.00000 -0.14500 0 0 0 4.71239</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_front_wheel_tread_lug_7">
        <pose>0.10253 -0.10253 0 0 0 5.49779</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
    </link>
    <link name="right_rear_wheel">
      <pose>-0.45 -0.34 0.15 1.57079632679 0 0</pose>
      <inertial>
        <mass>2.5</mass>
        <inertia><ixx>0.0171</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0171</iyy><iyz>0</iyz><izz>0.0281</izz></inertia>
      </inertial>
      <collision name="wheel_collision">
        <geometry><cylinder><radius>0.15</radius><length>0.12</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2><slip1>0.01</slip1><slip2>0.01</slip2></ode></friction></surface>
      </collision>
      <visual name="wheel_tire_visual">
        <geometry><cylinder><radius>0.15</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.055 0.055 0.060 1</ambient><diffuse>0.095 0.095 0.100 1</diffuse></material>
      </visual>
      <visual name="wheel_hub_visual">
        <geometry><cylinder><radius>0.087</radius><length>0.126</length></cylinder></geometry>
        <material><ambient>0.34 0.37 0.39 1</ambient><diffuse>0.48 0.52 0.54 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
      </visual>
      <visual name="right_rear_wheel_tread_lug_0">
        <pose>0.14500 0.00000 0 0 0 0.00000</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_rear_wheel_tread_lug_1">
        <pose>0.10253 0.10253 0 0 0 0.78540</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_rear_wheel_tread_lug_2">
        <pose>0.00000 0.14500 0 0 0 1.57080</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_rear_wheel_tread_lug_3">
        <pose>-0.10253 0.10253 0 0 0 2.35619</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_rear_wheel_tread_lug_4">
        <pose>-0.14500 0.00000 0 0 0 3.14159</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_rear_wheel_tread_lug_5">
        <pose>-0.10253 -0.10253 0 0 0 3.92699</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_rear_wheel_tread_lug_6">
        <pose>-0.00000 -0.14500 0 0 0 4.71239</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
      <visual name="right_rear_wheel_tread_lug_7">
        <pose>0.10253 -0.10253 0 0 0 5.49779</pose>
        <geometry><box><size>0.035 0.058 0.105</size></box></geometry>
        <material><ambient>0.07 0.07 0.075 1</ambient><diffuse>0.11 0.11 0.115 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>120</effort><velocity>25</velocity></limit>
        <dynamics><damping>0.02</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>
    <joint name="left_front_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_front_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>120</effort><velocity>25</velocity></limit>
        <dynamics><damping>0.02</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>
    <joint name="left_rear_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_rear_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>120</effort><velocity>25</velocity></limit>
        <dynamics><damping>0.02</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>120</effort><velocity>25</velocity></limit>
        <dynamics><damping>0.02</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>
    <joint name="right_front_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_front_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>120</effort><velocity>25</velocity></limit>
        <dynamics><damping>0.02</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>
    <joint name="right_rear_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_rear_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.0e16</lower><upper>1.0e16</upper><effort>120</effort><velocity>25</velocity></limit>
        <dynamics><damping>0.02</damping><friction>0.0</friction></dynamics>
      </axis>
    </joint>

    <!-- The camera looks along local +X; ROS image headers use the optical frame. -->
    <link name="camera_link">
      <pose relative_to="base_link">0.43 0 0.28 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
      </inertial>
      <visual name="camera_housing_visual">
        <!-- Keep the housing behind the optical centre so it cannot block the image. -->
        <pose>-0.06 0 0 0 0 0</pose>
        <geometry><box><size>0.12 0.11 0.08</size></box></geometry>
        <material>
          <ambient>0.16 0.19 0.22 1</ambient>
          <diffuse>0.20 0.24 0.27 1</diffuse>
        </material>
      </visual>
      <visual name="camera_lens_visual">
        <pose>0.012 0 0 0 1.57079632679 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.025 0.035 0.045 1</ambient><diffuse>0.035 0.055 0.070 1</diffuse></material>
      </visual>
      <sensor name="front_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>20</update_rate>
        <topic>/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.04719755</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip>
          <optical_frame_id>camera_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </link>
    <joint name="camera_mount_joint" type="fixed">
      <parent>base_link</parent><child>camera_link</child>
    </joint>

    <!-- Horizontal 360-degree range scan, centred at rover-forward +X. -->
    <link name="lidar_link">
      <pose relative_to="base_link">0.06 0 0.20 0 0 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia><ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0005</iyy><iyz>0</iyz><izz>0.0005</izz></inertia>
      </inertial>
      <visual name="lidar_housing_visual">
        <geometry><cylinder><radius>0.075</radius><length>0.055</length></cylinder></geometry>
        <material>
          <ambient>0.23 0.24 0.25 1</ambient>
          <diffuse>0.28 0.29 0.30 1</diffuse>
        </material>
      </visual>
      <sensor name="front_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>/scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples><resolution>1</resolution>
              <min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min><max>15.0</max><resolution>0.01</resolution>
          </range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
        </ray>
      </sensor>
    </link>
    <joint name="lidar_mount_joint" type="fixed">
      <parent>base_link</parent><child>lidar_link</child>
    </joint>

    <!-- One Gazebo DiffDrive system owns wheel control and wheel-model odometry.
         Keep the centre axle first: Fortress odometry integrates the first joint
         listed on each side, while velocity commands are applied to all entries. -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <wheel_separation>0.68</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>/cmd_vel_sim</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <min_linear_velocity>-0.35</min_linear_velocity>
      <max_linear_velocity>0.35</max_linear_velocity>
      <min_angular_velocity>-0.80</min_angular_velocity>
      <max_angular_velocity>0.80</max_angular_velocity>
      <min_linear_acceleration>-0.40</min_linear_acceleration>
      <max_linear_acceleration>0.40</max_linear_acceleration>
      <min_angular_acceleration>-0.90</min_angular_acceleration>
      <max_angular_acceleration>0.90</max_angular_acceleration>
    </plugin>
  </model>
</sdf>
