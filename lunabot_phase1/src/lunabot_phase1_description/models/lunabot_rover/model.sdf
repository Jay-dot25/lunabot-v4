<?xml version="1.0"?>
<sdf version="1.8">
  <model name="lunabot_rover">
    <static>false</static>

    <!--
      Phase 1 visual/physical reference: six wheels, overall envelope about
      1.2 x 0.8 x 0.6 m, 0.15 m wheel radius, and about 80 kg simulated mass.
      The side arms are fixed rocker-bogie-style visuals; the six wheels are
      driven in left/right groups by Fortress DiffDrive. This is not flight
      hardware or an articulated suspension model.
    -->
    <link name="base_link">
      <!-- base_link origin is the chassis centre; base_footprint is at z = 0. -->
      <pose>0 0 0.28 0 0 0</pose>
      <inertial>
        <mass>64.8</mass>
        <inertia>
          <ixx>2.2918</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>5.6160</iyy><iyz>0</iyz><izz>7.4760</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>1.00 0.62 0.20</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><box><size>1.00 0.62 0.20</size></box></geometry>
        <material>
          <ambient>0.66 0.67 0.64 1</ambient>
          <diffuse>0.72 0.73 0.70 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
        </material>
      </visual>
      <visual name="upper_deck_visual">
        <pose>-0.02 0 0.13 0 0 0</pose>
        <geometry><box><size>0.78 0.50 0.06</size></box></geometry>
        <material>
          <ambient>0.20 0.23 0.25 1</ambient>
          <diffuse>0.25 0.28 0.30 1</diffuse>
        </material>
      </visual>
      <visual name="lidar_mast_visual">
        <pose>0.06 0 0.14 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry>
        <material>
          <ambient>0.54 0.43 0.24 1</ambient>
          <diffuse>0.64 0.52 0.30 1</diffuse>
        </material>
      </visual>
      <visual name="solar_panel_visual">
        <pose>-0.02 0 0.168 0 0 0</pose>
        <geometry><box><size>0.56 0.44 0.012</size></box></geometry>
        <material>
          <ambient>0.07 0.14 0.22 1</ambient>
          <diffuse>0.09 0.20 0.32 1</diffuse>
          <specular>0.28 0.34 0.40 1</specular>
        </material>
      </visual>
      <!-- Low-profile side rails suggest rocker-bogie hardware while the Phase 1
           chassis remains rigid; wheel groups remain manually driven. -->
      <visual name="left_front_rocker_arm_visual">
        <pose>0.225 0.36 -0.085 0 0.18 0</pose>
        <geometry><box><size>0.55 0.075 0.065</size></box></geometry>
        <material><ambient>0.17 0.19 0.20 1</ambient><diffuse>0.22 0.24 0.25 1</diffuse></material>
      </visual>
      <visual name="left_rear_bogie_arm_visual">
