<?xml version="1.0"?>
<sdf version="1.8">
  <world name="lunar_base_camp">
    <physics name="lunar_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -1.62</gravity>
    <scene>
      <ambient>0.12 0.12 0.14 1</ambient>
      <background>0.008 0.010 0.018 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Systems required for rigid-body physics, entity updates and live sensors. -->
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="lunar_sun">
      <pose>0 0 30 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.88 0.86 0.80 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <direction>-0.45 0.20 -0.87</direction>
    </light>

    <!-- Level central test surface; low-relief mounds outside the spawn lane
         provide visible physical terrain without disturbing straight-line tests. -->
    <model name="lunar_regolith">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.34 0.35 0.36 1</ambient>
            <diffuse>0.42 0.43 0.44 1</diffuse>
            <specular>0.03 0.03 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Low-contrast visual albedo patches add surface variation only; they have
         no collision geometry and therefore cannot affect the rover's physics. -->
    <model name="regolith_patch_a">
      <static>true</static><pose>-1.2 1.5 0.002 0 0 0</pose>
      <link name="patch_link"><visual name="patch_visual">
        <geometry><box><size>4.0 2.2 0.002</size></box></geometry>
        <material><ambient>0.37 0.38 0.39 1</ambient><diffuse>0.39 0.40 0.41 1</diffuse></material>
      </visual></link>
    </model>
    <model name="regolith_patch_b">
      <static>true</static><pose>3.5 1.3 0.002 0 0 0</pose>
      <link name="patch_link"><visual name="patch_visual">
        <geometry><box><size>3.0 3.5 0.002</size></box></geometry>
        <material><ambient>0.32 0.33 0.34 1</ambient><diffuse>0.35 0.36 0.37 1</diffuse></material>
      </visual></link>
    </model>
    <model name="regolith_patch_c">
      <static>true</static><pose>1.0 -3.1 0.002 0 0 0</pose>
      <link name="patch_link"><visual name="patch_visual">
        <geometry><box><size>5.0 2.0 0.002</size></box></geometry>
        <material><ambient>0.36 0.37 0.38 1</ambient><diffuse>0.38 0.39 0.40 1</diffuse></material>
      </visual></link>
    </model>

    <!-- Shallow physical regolith mounds surround (but do not intrude into) the
         flat spawn / forward test lane. Their 4 m spheres sit mostly below the
         plane, leaving broad, gentle 0.25 m domes above the level surface. -->
    <model name="regolith_mound_northwest">
      <static>true</static><pose>-8 6 -3.75 0 0 0</pose>
      <link name="mound_link">
        <collision name="mound_collision"><geometry><sphere><radius>4.0</radius></sphere></geometry></collision>
        <visual name="mound_visual">
          <geometry><sphere><radius>4.0</radius></sphere></geometry>
          <material><ambient>0.26 0.25 0.23 1</ambient><diffuse>0.34 0.33 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="regolith_mound_northeast">
      <static>true</static><pose>8 6 -3.75 0 0 0</pose>
      <link name="mound_link">
        <collision name="mound_collision"><geometry><sphere><radius>4.0</radius></sphere></geometry></collision>
        <visual name="mound_visual">
          <geometry><sphere><radius>4.0</radius></sphere></geometry>
          <material><ambient>0.30 0.29 0.27 1</ambient><diffuse>0.39 0.38 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="regolith_mound_southwest">
      <static>true</static><pose>-8 -7 -3.75 0 0 0</pose>
      <link name="mound_link">
        <collision name="mound_collision"><geometry><sphere><radius>4.0</radius></sphere></geometry></collision>
        <visual name="mound_visual">
          <geometry><sphere><radius>4.0</radius></sphere></geometry>
          <material><ambient>0.29 0.28 0.26 1</ambient><diffuse>0.37 0.36 0.33 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="regolith_mound_southeast">
      <static>true</static><pose>8 -7 -3.75 0 0 0</pose>
      <link name="mound_link">
        <collision name="mound_collision"><geometry><sphere><radius>4.0</radius></sphere></geometry></collision>
        <visual name="mound_visual">
          <geometry><sphere><radius>4.0</radius></sphere></geometry>
          <material><ambient>0.24 0.23 0.22 1</ambient><diffuse>0.32 0.31 0.29 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Main rover: wheels contact z=0, with a clear forward test lane to the
         physical blocker at x=2 m. The include resolves via IGN_GAZEBO_RESOURCE_PATH. -->
    <include>
      <uri>model://lunabot_rover</uri>
      <name>lunabot</name>
      <pose>-2.5 0 0 0 0 0</pose>
    </include>

    <!-- Small rock: spherical visual and collision geometry are both present. -->
    <model name="small_rock">
      <static>true</static><pose>0.0 2.1 0.19 0 0 0</pose>
      <link name="rock_link">
        <collision name="rock_collision"><geometry><sphere><radius>0.19</radius></sphere></geometry></collision>
        <visual name="rock_visual">
          <geometry><sphere><radius>0.19</radius></sphere></geometry>
          <material><ambient>0.25 0.26 0.27 1</ambient><diffuse>0.31 0.32 0.33 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Larger boulder for visible long-range camera / LiDAR tests. -->
    <model name="large_boulder">
      <static>true</static><pose>1.0 1.55 0.42 0 0 0</pose>
      <link name="boulder_link">
        <collision name="boulder_collision"><geometry><sphere><radius>0.42</radius></sphere></geometry></collision>
        <visual name="boulder_visual">
          <geometry><sphere><radius>0.42</radius></sphere></geometry>
          <material><ambient>0.22 0.23 0.24 1</ambient><diffuse>0.27 0.28 0.29 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Low physical hurdle: deliberately shorter than the main blocker. -->
    <model name="low_obstacle">
      <static>true</static><pose>0.4 -1.65 0.30 0 0 0</pose>
      <link name="hurdle_link">
        <collision name="hurdle_collision"><geometry><box><size>0.85 0.65 0.60</size></box></geometry></collision>
        <visual name="hurdle_visual">
          <geometry><box><size>0.85 0.65 0.60</size></box></geometry>
          <material><ambient>0.42 0.35 0.27 1</ambient><diffuse>0.48 0.40 0.31 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Large, unambiguous obstacle on the initial straight drive line. -->
    <model name="forward_blocker">
      <static>true</static><pose>2.0 0 0.45 0 0 0</pose>
      <link name="blocker_link">
        <collision name="blocker_collision"><geometry><box><size>0.90 0.90 0.90</size></box></geometry></collision>
        <visual name="blocker_visual">
          <geometry><box><size>0.90 0.90 0.90</size></box></geometry>
          <material><ambient>0.53 0.32 0.18 1</ambient><diffuse>0.61 0.38 0.21 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A small manoeuvring cluster with rover-width gaps. -->
    <model name="cluster_rock_a">
      <static>true</static><pose>3.3 -2.4 0.28 0 0 0</pose>
      <link name="rock_link">
        <collision name="rock_collision"><geometry><sphere><radius>0.28</radius></sphere></geometry></collision>
        <visual name="rock_visual"><geometry><sphere><radius>0.28</radius></sphere></geometry><material><ambient>0.25 0.26 0.27 1</ambient><diffuse>0.31 0.32 0.33 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cluster_rock_b">
      <static>true</static><pose>4.25 -1.35 0.37 0 0 0</pose>
      <link name="rock_link">
        <collision name="rock_collision"><geometry><sphere><radius>0.37</radius></sphere></geometry></collision>
        <visual name="rock_visual"><geometry><sphere><radius>0.37</radius></sphere></geometry><material><ambient>0.20 0.21 0.22 1</ambient><diffuse>0.26 0.27 0.28 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cluster_rock_c">
      <static>true</static><pose>4.2 -3.25 0.25 0 0 0</pose>
      <link name="rock_link">
        <collision name="rock_collision"><geometry><box><size>0.60 0.58 0.50</size></box></geometry></collision>
        <visual name="rock_visual"><geometry><box><size>0.60 0.58 0.50</size></box></geometry><material><ambient>0.34 0.31 0.28 1</ambient><diffuse>0.40 0.37 0.33 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
